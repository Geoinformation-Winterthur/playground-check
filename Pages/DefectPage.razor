@page "/defect/{playdeviceFid:int}/{tid:int}"
@using playground_check.Helper
@using playground_check.Model
@using playground_check.Services
@attribute [Authorize]
@inject IDefectService DefectService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Spielplatzkontrolle - Mangel</PageTitle>

@if (defect.tid != 0)
{
    <h1>Mangel @defect.tid</h1>
}
else
{
    <h1>Neuer Mangel</h1>
}

<p><b>Erstellt am: @defect.dateCreation?.ToString("dd.MM.yyyy")</b></p>

<div style="width: 100%;margin: 0.5em;">
    <h4>Beschrieb des Mangels</h4>
    <textarea matInput maxlength="255" @bind="defect.defectDescription" placeholder="Beschrieb des Mangels..."
        style="width: 100%;"></textarea>
</div>
<form-field appearance="fill" style="margin:0.5em;">
    <label>Dringlichkeit</label><br>
    <select name="urgancy" @bind="defect.priority" class="form-select">
        <option value="1">A (sofort)</option>
        <option value="2">B (mittelfristig)</option>
        <option value="3">C (Ohne Gefahr, muss im Folgejahr beurteilt werden)</option>
    </select>
</form-field>
<form-field appearance="fill" style="margin:0.5em;">
    <label>Zuständigkeit</label><br>
    <select name="responsible" @bind="defect.defectsResponsibleBodyId" class="form-select">
        <option value="1">Revier</option>
        <option value="2">Spielplatzverantwortlicher</option>
        <option value="3">Projektleiter</option>
    </select>
</form-field>
<div style="margin: 2em;padding: 1em;border: 1px dashed rgb(55, 124, 227);background-color: rgb(214, 227, 242);">
    <p style="color: rgb(28, 89, 180);">Fotos des Mangels</p>
    @if (defect.tid != 0 && defect.defectPicsTids.Length < 3)
    {
        <InputFile OnChange="e => UploadImage(false, e)" accept="image/png" style="padding: 1em;" />
    }
    @foreach (int defectPicTid in defect.defectPicsTids)
    {
        @if (defectThumbs.TryGetValue(defectPicTid, out var thumbSrc) &&
             defectFullImages.TryGetValue(defectPicTid, out var fullSrc))
        {
            <a href="@fullSrc" target="_blank">
                <img title="Foto des Mangels" src="@thumbSrc"
                     width="30%" style="margin: 2px;border: 1px solid rgb(160, 188, 230);" />
            </a>
        }
    }
</div>
<hr>
<p><b>Erledigung des Mangels:</b></p>
<p>
    <input type="checkbox" @bind="defect.done" @onclick="SwitchDefectStatus" style="margin:10px;" />
    Mangel erledigt
</p>
@if (defect.done)
{
    <div style="margin: 2em;padding: 1em;border: 1px dashed rgb(218, 104, 69);background-color: rgb(245, 239, 245);">
        <p style="color: rgb(172, 73, 43);">Fotos nach Mangelbeseitigung</p>
        @if (defect.tid != 0 && defect.defectPicsAfterFixingTids.Length < 3)
        {
            <InputFile OnChange="e => UploadImage(true, e)" accept="image/png" style="padding: 1em;" />
        }
        @foreach (int defectPicTid in defect.defectPicsAfterFixingTids)
        {
            @if (defectThumbs.TryGetValue(defectPicTid, out var thumbSrc) &&
                 defectFullImages.TryGetValue(defectPicTid, out var fullSrc))
            {
                <a href="@fullSrc" target="_blank">
                    <img title="Foto des Mangels" src="@thumbSrc"
                         width="30%" style="margin: 2px;border: 1px solid rgb(160, 188, 230);" />
                </a>
            }
        }
    </div>
}
<p><span><i>Datum der Erledigung: </i>
        @if (defect.dateDone != null)
        {
            <span>@defect.dateDone?.ToString("dd.MM.yyyy")</span>
        }
        else
        {
            <span>Noch nicht erledigt</span>
        }
    </span></p>
<form-field style="width: 100%;margin: 0.5em;">
    <label>Bemerkung zur Erledigung</label><br>
    <textarea matInput maxlength="255" @bind="defect.defectComment"
        placeholder="Bemerkung zur Erledigung..."></textarea>
</form-field>
<p><i>Erledigt durch</i>:
    @if (defect.dateDone == null)
    {
        <span>Noch nicht erledigt</span>
    }
    else
    {
        <AuthorizeView>
            <Authorized>
                <span>@context.User.FindFirst("firstName")?.Value @context.User.FindFirst("lastName")?.Value</span>
            </Authorized>
            <NotAuthorized>
                <span>keine Benutzerdaten</span>
            </NotAuthorized>
        </AuthorizeView>
    }
</p>

@if (defect.tid != 0)
{
    <button class="btn btn-primary" @onclick="UpdateDefect" style="margin: 2em;">Speichern</button>
}
else
{
    <button class="btn btn-primary" @onclick="CreateDefect" style="margin: 2em;">Anlegen</button>
}

@code {
    [Parameter] public int tid { get; set; }
    [Parameter] public int playdeviceFid { get; set; }

    private Defect defect = new();
    private Dictionary<int, string> defectThumbs = new();
    private Dictionary<int, string> defectFullImages = new();

    protected override async Task OnInitializedAsync()
    {
        if (tid > 0)
        {
            defect = DefectService.Get(tid);

            foreach (var picTid in defect.defectPicsTids)
            {
                defectThumbs[picTid] = await DefectService.GetPictureAsync(picTid, thumb: true);
                defectFullImages[picTid] = await DefectService.GetPictureAsync(picTid, thumb: false);
            }

            foreach (var picTid in defect.defectPicsAfterFixingTids)
            {
                defectThumbs[picTid] = await DefectService.GetPictureAsync(picTid, thumb: true);
                defectFullImages[picTid] = await DefectService.GetPictureAsync(picTid, thumb: false);
            }
        }
        else
        {
            defect = new Defect
            {
                playdeviceFid = playdeviceFid,
                dateCreation = DateTime.Now
            };
        }
    }

    private void SwitchDefectStatus()
    {
        if (defect.dateDone != null)
            defect.dateDone = null;
        else
            defect.dateDone = DateTime.Now;
    }

    private async Task CreateDefect()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        DefectService.Create(defect, user);
    }

    private async Task UpdateDefect()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        DefectService.Update(defect, user);
    }

    private async Task UploadImage(bool afterFixing, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (defect.tid != 0 && file != null)
        {
            DefectPicture defectPicture = new DefectPicture();
            defectPicture.afterFixing = afterFixing;
            using var stream = file.OpenReadStream(50 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            string base64String = Convert.ToBase64String(ms.ToArray());
            defectPicture.base64StringPicture = ImageHelper.DownsizeImage(base64String, 1200, 800);
            defectPicture.base64StringPictureThumb = ImageHelper.DownsizeImage(base64String, 400, 400);
            defectPicture.base64StringPictureThumb = ImageHelper.CropImage(defectPicture.base64StringPictureThumb, 1, 1);

            await DefectService.PutPictureAsync(defectPicture, defect.tid, false);

            // Nach dem Upload neu laden (vereinfachte Annahme: letzte TID ist neueste)
            // Alternativ: defect.defectPicsTids / defect.defectPicsAfterFixingTids neu laden
            StateHasChanged();
        }
    }
}
