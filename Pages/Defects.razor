@page "/defects"
@attribute [Authorize]
@using playground_check.Model
@using playground_check.Services
@inject IPlaygroundService PlaygroundService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Spielplatzkontrolle - Mängel</PageTitle>

<h1>Mängel</h1>

<label for="playground">Spielplatz</label>
<select name="playground" @onchange="OnPlaygroundChanged" class="form-select">
    <option value="">Bitte auswählen</option>
    @foreach (var playground in playgrounds)
    {
        <option value="@playground.name">@playground.name &nbsp;
            @if (playground.hasOpenDeviceDefects)
            {
                <span>(Mangel)</span>
            }
        </option>
    }
</select>

@foreach (var playdevice in playground.playdevices)
{
    <div style="margin: 2em;padding: 1em;border: 1px solid grey">
        <h3>@playdevice.properties.type.description</h3>
        @if (playdevice.properties.cannotBeChecked)
        {
            <p><b>Kann nicht geprüft werden</b></p>
        }
        else
        {
            <p><b>Kann geprüft werden</b></p>
        }
        <div>
            <img title="Foto des Spielger&auml;ts"
                style="display: block;width: 50%;margin-left: auto;margin-right: auto;margin-top: 0.5em;"
                src="Playdevice/@playdevice.properties.fid/Picture?dryRun=false">
        </div>
        <p><b>Lieferant</b>: @playdevice.properties.supplier</p>
        @if (playdevice.properties.defects.Length != 0)
        {
            <p>Mängel:</p>
            @foreach (var defect in playdevice.properties.defects)
            {
                <div>
                    @defect.defectDescription&nbsp;
                    <NavLink class="btn btn-primary" href="@($"/defect/{playdevice.properties.fid}/{defect.tid}")">Öffnen</NavLink>
                </div>
            }
        }
        else
        {
            <p>Keine Mängel</p>
        }
        <NavLink class="btn btn-primary" href="@($"/defect/{playdevice.properties.fid}/0")">Neuer Mangel</NavLink>
    </div>
}

@code {
    private IEnumerable<Playground> playgrounds = new Playground[0];
    private Playground playground = new Playground();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        playgrounds = PlaygroundService.GetOnlyNames("Keine Inspektion", user);
    }

    private async Task OnPlaygroundChanged(ChangeEventArgs e)
    {
        string playgroundName = e.Value?.ToString() ?? "";

        if (playgroundName != "")
        {
            playground = PlaygroundService.GetByName(playgroundName, "Keine Inspektion", true);
        }
        else
        {
            playground = new Playground();
        }
    }
}