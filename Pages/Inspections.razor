@page "/inspections"
@attribute [Authorize]
@using playground_check.Model
@using playground_check.Services
@inject IPlaygroundService PlaygroundService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject AppStateProvider AppStateProvider

<PageTitle>Spielplatzkontrolle - Inspektion</PageTitle>

<h1>Inspektion</h1>

<label for="inspectiontype">Inspektionsart</label>
<select name="inspectiontype" @onchange="OnInspectionTypeChanged" class="form-select">
    <option value="">Bitte auswählen</option>
    <option value="Keine Inspektion">Keine Inspektion</option>
    <option value="Visuelle Inspektion (VI)">Visuelle Inspektion (VI)</option>
    <option value="Operative Inspektion (OI)">Operative Inspektion (OI)</option>
    <option value="Hauptinspektion (HI)">Hauptinspektion (HI)</option>
</select>

<label for="playground">Spielplatz</label>
<select name="playground" @onchange="OnPlaygroundChanged" class="form-select">
    <option value="">Bitte auswählen</option>
    @foreach (var playground in playgrounds)
    {
        <option value="@playground.name">@playground.name</option>
    }
</select>

@foreach (var playdevice in AppStateProvider.playground.playdevices)
{
    <div style="margin: 2em;padding: 1em;border: 1px solid grey">
        <h3>@playdevice.properties.type.description</h3>
        @if (playdevice.properties.cannotBeChecked)
        {
            <div style="margin: 0.5em;padding: 0.5em;background-color: rgb(225, 208, 247)"><b>inaktiv</b></div>
        }
        else if (playdevice.properties.notToBeChecked)
        {
            <div style="margin: 0.5em;padding: 0.5em;background-color: rgb(238, 213, 144)"><b>inaktiv</b></div>
        }

        @if (!playdevice.properties.hasChecks)
        {
            <div style="background-color: rgb(218, 218, 218)">keine&nbsp;Kontrollen</div>
        }
        else
        {
            @if (!playdevice.properties.cannotBeChecked && !playdevice.properties.notToBeChecked
                && playdevice.properties.hasChecks && !playdevice.properties.hasOpenChecks)
            {
                <div style="background-color: lightgreen" @onclick="() => playdevice.switchAllCheckBoxes(false)">erledigt
                </div>
            }
            else
            {
                <div style="background-color: rgb(238, 171, 144)" @onclick="() => playdevice.switchAllCheckBoxes(true)">
                    pendent</div>
            }
        }

        @if (playdevice.properties.pictureBase64String != null)
        {
            <div>
                <img title="Foto des Spielger&auml;ts"
                    style="display: block;width: 50%;margin-left: auto;margin-right: auto;margin-top: 0.5em;"
                    src="@playdevice.properties.pictureBase64String">
                @if (!playdevice.properties.notToBeChecked)
                {
                    <div>
                        <span style="font-size: 50%;margin-left:1em;">Foto ersetzen...</span>
                        <input type="file" accept="image/png" style="padding: 1em;">
                    </div>
                }
            </div>
        }
        <p><b>Lieferant</b>: @playdevice.properties.supplier</p>
        <div>
            <NavLink class="btn btn-primary" href="@($"/playdevice/{playdevice.properties.fid}")">Öffnen</NavLink>
        </div>
    </div>
}

<div><button class="btn btn-primary">Abschliessen</button></div>

@code {
    private IEnumerable<Playground> playgrounds = new Playground[0];

    private async Task OnInspectionTypeChanged(ChangeEventArgs e)
    {
        AppStateProvider.selectedInspectionType = e.Value?.ToString() ?? "";

        if (AppStateProvider.selectedInspectionType != "")
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            playgrounds = PlaygroundService.GetOnlyNames(AppStateProvider.selectedInspectionType, user);
        }
    }

    private async Task OnPlaygroundChanged(ChangeEventArgs e)
    {
        string playgroundName = e.Value?.ToString() ?? "";

        if (playgroundName != "")
        {
            AppStateProvider.playground = PlaygroundService.GetByName(playgroundName, AppStateProvider.selectedInspectionType);
            foreach(var playdevice in AppStateProvider.playground.playdevices){
                playdevice.evaluateChecks();
            }
        }
        else
        {
            AppStateProvider.playground = new Playground();
        }
    }

}
