@page "/inspections"
@attribute [Authorize]
@using playground_check.Model
@using playground_check.Services
@inject IPlaygroundService PlaygroundService
@inject IInspectionService InspectionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject AppStateProvider AppStateProvider
@inject SnackbarService SnackbarService

<PageTitle>Spielplatzkontrolle - Inspektion</PageTitle>

<h1>Inspektion</h1>

<label for="inspectiontype">Inspektionsart</label><br>
<select name="inspectiontype" @bind="AppStateProvider.selectedInspectionType" @bind:after="OnInspectionTypeChanged"
    class="form-select">
    <option value="">Bitte auswählen</option>
    <option value="Visuelle Inspektion (VI)">Visuelle Inspektion (VI)</option>
    <option value="Operative Inspektion (OI)">Operative Inspektion (OI)</option>
    <option value="Hauptinspektion (HI)">Hauptinspektion (HI)</option>
</select>

<label for="playground">Spielplatz</label><br>
<select name="playground" @bind="AppStateProvider.selectedPlaygroundName" @bind:after="OnPlaygroundChanged"
    class="form-select">
    <option value="">Bitte auswählen</option>
    @foreach (var playground in playgrounds)
    {
        <option value="@playground.name">@playground.name&nbsp;
            @if (!playground.dateOfLastInspection.ToString("yyyy.MM.dd").StartsWith("0001"))
            {
                <span>(letzte: @playground.dateOfLastInspection.ToString("dd.MM.yyyy"))</span>
            }
            @if (playground.inspectionSuspended)
            {
                <span>(ausgesetzt)</span>
            }
        </option>
    }
</select>

@if (AppStateProvider.playground.inspectionSuspended)
{
    <p style="background-color: rgb(232, 243, 255);border: 2px solid;color:rgb(86, 86, 212);margin-top: 2em;padding: 1em;">
        Beim ausgewählten Spielplatz ist die Inspektion
        @if (AppStateProvider.playground.suspendInspectionFrom != null)
        {
            <span>vom @AppStateProvider.playground.suspendInspectionFrom?.ToString("dd.MM.yyyy")</span>
        }
        @if (AppStateProvider.playground.suspendInspectionTo != null)
        {
            <span> bis zum @AppStateProvider.playground.suspendInspectionTo?.ToString("dd.MM.yyyy")</span>
        }
        ausgesetzt.
    </p>
}

@foreach (var playdevice in AppStateProvider.playground.playdevices)
{
    <div style="margin: 2em;padding: 1em;border: 1px solid grey">
        <h3>@playdevice.properties.type.description</h3>
        @if (playdevice.properties.cannotBeChecked)
        {
            <div style="margin: 0.5em;padding: 0.5em;background-color: rgb(225, 208, 247)"><b>inaktiv</b></div>
        }
        else if (playdevice.properties.notToBeChecked)
        {
            <div style="margin: 0.5em;padding: 0.5em;background-color: rgb(238, 213, 144)"><b>inaktiv</b></div>
        }

        @if (!playdevice.properties.hasChecks)
        {
            <div style="background-color: rgb(218, 218, 218)">keine&nbsp;Kontrollen</div>
        }
        else
        {
            @if (!playdevice.properties.cannotBeChecked && !playdevice.properties.notToBeChecked
                && playdevice.properties.hasChecks && !playdevice.properties.hasOpenChecks)
            {
                <div style="background-color: lightgreen" @onclick="() => playdevice.switchAllCheckBoxes(false)">erledigt
                </div>
            }
            else
            {
                <div style="background-color: rgb(238, 171, 144)" @onclick="() => playdevice.switchAllCheckBoxes(true)">
                    pendent</div>
            }
        }

        <div>
            <a title="Link auf Kartenausschnitt Spielger&auml;t" target="_blank"
                href="https://stadtplan.winterthur.ch/mini?gbapp=portal&topic=Spielplatzkarte&infoactive=1&maponly=1&onlymap=1&scale=200&x=@playdevice.geometry.coordinates[0]&y=@playdevice.geometry.coordinates[1]&back=Hintergrundkarte_LK_AV_Situationsplan">
                <img title="Foto des Spielger&auml;ts"
                    style="display: block;width: 50%;margin-left: auto;margin-right: auto;margin-top: 0.5em;"
                    src="Playdevice/@playdevice.properties.fid/Picture?dryRun=false">
            </a>
        </div>
        <p><b>Lieferant</b>: @playdevice.properties.supplier</p>
        @if (!playdevice.properties.cannotBeChecked)
        {
            <div>
                <NavLink class="btn btn-primary" href="@($"playdevice/{playdevice.properties.fid}")">
                    Öffnen
                </NavLink>
            </div>
        }
    </div>
}

@if (AppStateProvider.playground.playdevices.Length != 0)
{
    <div style="margin: 1em;">
        <button class="btn btn-primary" @onclick="FinishInspection" disabled="@(!CanFinish())">Abschliessen</button>
        @if (!string.IsNullOrWhiteSpace(errorText))
        {
            @if (errorText.StartsWith("SPK"))
            {
                <span style="color: red;margin: 1em;font-style: bold;">@ErrorMessageDictionary.Get(errorText)</span>
            }
            else
            {
                <span style="color: green;margin: 1em;font-style: bold;">Bericht erfolgreich gesendet</span>
            }
        }
    </div>
}

@code {
    private IEnumerable<Playground> playgrounds = new Playground[0];

    private string errorText = "";

    private async Task OnInspectionTypeChanged()
    {
        if (AppStateProvider.selectedInspectionType != "")
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            playgrounds = PlaygroundService.GetOnlyNames(AppStateProvider.selectedInspectionType, user);
        }
    }

    private async Task OnPlaygroundChanged()
    {
        if (AppStateProvider.selectedPlaygroundName != "")
        {
            AppStateProvider.playground = PlaygroundService
            .GetByName(AppStateProvider.selectedPlaygroundName,
            AppStateProvider.selectedInspectionType, false);
            foreach (var playdevice in AppStateProvider.playground.playdevices)
            {
                playdevice.evaluateChecks();
            }
        }
        else
        {
            AppStateProvider.playground = new Playground();
        }
    }

    private bool CanFinish()
    {
        if (AppStateProvider.playground == null)
            return false;

        foreach (var playdevice in AppStateProvider.playground.playdevices)
        {
            // Wenn Gerät prüfbar ist
            if (!playdevice.properties.notToBeChecked &&
            !playdevice.properties.cannotBeChecked)
            {
                // Checks auswerten
                playdevice.evaluateChecks();
                if (playdevice.properties.hasOpenChecks)
                    return false;
            }
            // Wenn Gerät nicht prüfbar ist, aber kein Grund angegeben
            else if (playdevice.properties.cannotBeChecked &&
            string.IsNullOrWhiteSpace(playdevice.properties.cannotBeCheckedReason))
                return false;
        }

        return true;
    }

    private async Task FinishInspection()
    {

        var inspectionReports = new List<InspectionReport>();

        foreach (var playdevice in AppStateProvider.playground.playdevices)
        {
            DateTime dateOfService = DateTime.Now;

            // Nur Geräte berücksichtigen, die nicht als "nicht zu prüfen" markiert sind
            if (!playdevice.properties.notToBeChecked && !playdevice.properties.cannotBeChecked)
            {
                // Allgemeine Prüfung
                _CollectInspectionReports(
                playdevice.properties.generalInspectionCriteria,
                inspectionReports,
                playdevice.properties.fid,
                0,
                "",
                dateOfService
                );

                // Hauptfallschutz-Prüfung
                _CollectInspectionReports(
                playdevice.properties.mainFallProtectionInspectionCriteria,
                inspectionReports,
                playdevice.properties.fid,
                0,
                "Hauptfallschutz",
                dateOfService
                );

                // Nebenfallschutz-Prüfung
                _CollectInspectionReports(
                playdevice.properties.secondaryFallProtectionInspectionCriteria,
                inspectionReports,
                playdevice.properties.fid,
                0,
                "Nebenfallschutz",
                dateOfService
                );
            }
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        InspectionReport[] inspectionReportsArray = inspectionReports.ToArray();
        var result = InspectionService.SendReport(inspectionReportsArray, user, false);
        if (string.IsNullOrWhiteSpace(result.errorMessage))
        {
            await SnackbarService.ShowAsync("Bericht erfolgreich gesendet", 3000);
            AppStateProvider.selectedInspectionType = "";
            AppStateProvider.selectedPlaygroundName = "";
            this.playgrounds = new Playground[0];
        }
        else
        {
            errorText = result.errorMessage;
            await SnackbarService.ShowAsync(result.errorMessage, 3000);
        }
    }

    /// <summary>
    /// Verarbeitet eine Liste von <see cref="InspectionCriterion"/> und extrahiert daraus gültige
    /// <see cref="InspectionReport"/>-Objekte, ergänzt diese mit Metadaten (FIDs, Datum, Fallschutztyp)
    /// und fügt sie der Ziel-Liste <paramref name="inspectionReports"/> hinzu.
    /// </summary>
    /// <param name="inspectionCriteria">
    /// Eine Liste von Inspektionskriterien, die jeweils einen zugehörigen <see cref="InspectionReport"/>
    /// enthalten können.
    /// </param>
    /// <param name="inspectionReports">
    /// Die Ziel-Liste, in die alle vervollständigten <see cref="InspectionReport"/>-Instanzen eingefügt werden.
    /// </param>
    /// <param name="playdeviceFid">
    /// Die eindeutige ID des Spielgeräts, auf das sich die Prüfung bezieht.
    /// </param>
    /// <param name="playdeviceDetailFid">
    /// Die Detail-ID des Spielgeräts (z. B. für Komponenten, Module etc.).
    /// </param>
    /// <param name="fallProtectionType">
    /// Der Typ der Fallschutzvorkehrung (z. B. Sand, Gummi, Holzschnitzel).
    /// </param>
    /// <param name="playdeviceDateOfService">
    /// Das Datum, an dem das Spielgerät zuletzt in Betrieb genommen oder geprüft wurde (optional).
    /// Wird, falls vorhanden, intern auf 12:00 Uhr mittags gesetzt (zur Vermeidung von Zeitzoneneffekten).
    /// </param>
    private void _CollectInspectionReports(
    InspectionCriterion[] inspectionCriteria,
    List<InspectionReport> inspectionReports,
    int playdeviceFid,
    int playdeviceDetailFid,
    string fallProtectionType,
    DateTime playdeviceDateOfService)
    {
        // Sicherstellen, dass die Eingabeliste gültig ist.
        if (inspectionCriteria == null)
            return;

        // Schleife über alle Inspektionskriterien
        foreach (var inspectionCriterion in inspectionCriteria)
        {
            // Nur solche Kriterien berücksichtigen, die tatsächlich einen Prüfbericht enthalten
            if (inspectionCriterion.currentInspectionReport != null)
            {
                InspectionReport report = inspectionCriterion.currentInspectionReport;

                // Spielgerät-IDs setzen
                report.playdeviceFid = playdeviceFid;
                report.playdeviceDetailFid = playdeviceDetailFid;

                // Datum übernehmen
                report.playdeviceDateOfService = playdeviceDateOfService;

                // Fallschutztyp setzen
                report.fallProtectionType = fallProtectionType;

                // Den Bericht in die Ziel-Liste aufnehmen
                inspectionReports.Add(report);
            }
        }
    }

}
