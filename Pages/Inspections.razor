@page "/inspections"
@attribute [Authorize]
@using playground_check.Model
@using playground_check.Services
@inject IPlaygroundService PlaygroundService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Spielplatzkontrolle - Inspektion</PageTitle>

<h1>Inspektion</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<div>
    <table class="table">
    <thead>
        <tr>
            <th>Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var playground in playgrounds)
        {
            <tr>
                <td>@playground.name</td>
            </tr>
        }
    </tbody>
    </table>
</div>

@code {
    private int currentCount = 0;

    private IEnumerable<Playground> playgrounds;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        playgrounds = PlaygroundService.GetOnlyNames("Keine Inspektion", user);
    }

    private void IncrementCount()
    {
        currentCount++;
    }
}
