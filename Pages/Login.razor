@page "/login"
@using playground_check.Controllers
@using playground_check.Model
@inject CustomAuthStateProvider AuthProvider
@inject LoginController LoginController
@inject NavigationManager Nav

<EditForm Model="loginObj" OnValidSubmit="HandleLogin">
    <InputText @bind-Value="loginObj.mailAddress" placeholder="Benutzername" />
    <InputText @bind-Value="loginObj.passPhrase" type="password" placeholder="Passwort" />
    <button type="submit">Login</button>
</EditForm>

<p>Test: @Nav.BaseUri</p>

@if (!string.IsNullOrEmpty(Error))
{
    <p style="color:red">@Error</p>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? returnUrl { get; set; }

    private User loginObj = new();
    private string? Error;

    private async Task HandleLogin()
    {
        var result = await LoginController.AuthenticateAsync(loginObj, false);

        if (result.Success && result.User != null)
        {
            AuthProvider.MarkUserAsAuthenticated(result.User, result.User.role);
            Error = null;

            var basePath = Nav.BaseUri.TrimEnd('/');

            if (!string.IsNullOrEmpty(returnUrl) && returnUrl.StartsWith(basePath))
                Nav.NavigateTo(returnUrl, forceLoad: false);
            else
                Nav.NavigateTo(basePath + "/", forceLoad: false);

        }
        else
        {
            Error = result.ErrorMessage;
        }
    }

}
