@page "/playdevices"
@attribute [Authorize]
@using playground_check.Model
@using playground_check.Services
@using playground_check.Helper
@inject IPlaygroundService PlaygroundService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Spielplatzkontrolle - Spielgeräte</PageTitle>

<h1>Spielgeräteübersicht</h1>

<label for="playground">Spielplatz</label>
<select name="playground" @bind="playground.name" @bind:after="OnPlaygroundChanged" class="form-select">
    <option value="">Bitte auswählen</option>
    @foreach (var playground in playgrounds)
    {
        <option value="@playground.name">@playground.name</option>
    }
</select>

@foreach (var playdevice in playground.playdevices)
{
    <div style="margin: 2em;padding: 1em;border: 1px solid grey">
        <h3>@playdevice.properties.type.description</h3>
        @if (playdevice.properties.cannotBeChecked)
        {
            <div style="margin: 0.5em;padding: 0.5em;background-color: rgb(225, 208, 247)"><b>inaktiv</b></div>
        }
        else if (playdevice.properties.notToBeChecked)
        {
            <div style="margin: 0.5em;padding: 0.5em;background-color: rgb(238, 213, 144)"><b>inaktiv</b></div>
        }

        @if (playdevice.properties.pictureBase64String != null)
        {
            <div>
                <img title="Foto des Spielger&auml;ts"
                    style="display: block;width: 50%;margin-left: auto;margin-right: auto;margin-top: 0.5em;"
                    src="https://localhost:7014/Playdevice/@playdevice.properties.fid/Picture?t=@(imageCacheBuster.TryGetValue(playdevice.properties.fid, out var val) ? val : "")">
                @if (!playdevice.properties.notToBeChecked)
                {
                    <div>
                        <span style="font-size: 50%;margin-left:1em;">Foto ersetzen...</span>
                        <InputFile OnChange="e => UploadImage(playdevice.properties.fid, e)" accept="image/png"
                            style="padding: 1em;" />
                    </div>
                }
            </div>
        }
        <p><b>Lieferant</b>: @playdevice.properties.supplier</p>
    </div>
}

@code {
    private IEnumerable<Playground> playgrounds = new Playground[0];
    private Playground playground = new Playground();
    private Dictionary<int, string> imageCacheBuster = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        playgrounds = PlaygroundService.GetOnlyNames("Keine Inspektion", user);
    }

    private async Task OnPlaygroundChanged()
    {
        if (playground.name != "")
        {
            playground = PlaygroundService
            .GetByName(playground.name, "Keine Inspektion");
        }
        else
        {
            playground = new Playground();
        }
    }

    private async Task UploadImage(int playdeviceFid, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream(50 * 1024 * 1024); // 50MB max picture size
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            string base64String = Convert.ToBase64String(ms.ToArray());
            base64String = ImageHelper.DownsizeImage(base64String, 1200, 800);

            await PlaygroundService.PutPlaydevicePictureAsync(playdeviceFid, base64String, false);

            // Cache-Buster aktualisieren
            imageCacheBuster[playdeviceFid] = DateTime.UtcNow.Ticks.ToString();
            StateHasChanged(); // Bild neu rendern
        }
    }

}
