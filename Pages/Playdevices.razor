@page "/playdevices"
@attribute [Authorize]
@using playground_check.Model
@using playground_check.Services
@using playground_check.Helper
@inject IPlaygroundService PlaygroundService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Spielplatzkontrolle - Spielgeräte</PageTitle>

<h1>Spielgeräteübersicht</h1>

<label for="playground">Spielplatz</label><br>
<select name="playground" @bind="playground.name" @bind:after="OnPlaygroundChanged" class="form-select">
    <option value="">Bitte auswählen</option>
    @foreach (var playground in playgrounds)
    {
        <option value="@playground.name">@playground.name</option>
    }
</select>

@if (playground.documentsOfAcceptanceFids != null &&
playground.documentsOfAcceptanceFids.Length != 0)
{
    <div
        style="background-color: rgb(219, 235, 224);padding-left: 1em;padding-right: 1em;padding-bottom: 1em;margin-top: 2em;border: 1px dotted rgb(87, 235, 136);">
        <h4>Abnahmedokumente</h4>
        @foreach (int documentOfAcceptanceFid in playground.documentsOfAcceptanceFids)
        {
            <span>
                <a title="Link auf Kartenausschnitt Spielger&auml;t" target="_blank"
                    href="Document/@documentOfAcceptanceFid?type=abnahme">
                    @documentOfAcceptanceFid
                </a>&nbsp;
            </span>
        }
    </div>
}

@if (playground.certificateDocumentsFids != null &&
playground.certificateDocumentsFids.Length != 0)
{
    <div
        style="background-color: rgb(230, 244, 255);padding-left: 1em;padding-right: 1em;padding-bottom: 1em;margin-top: 2em;border: 1px dotted blue;">
        <h4>Zertifikatsdokumente</h4>
        @foreach (int certificateDocumentFid in playground.certificateDocumentsFids)
        {
            <span>
                <a title="Link auf Kartenausschnitt Spielger&auml;t" target="_blank"
                    href="Document/@certificateDocumentFid?type=zertifikat">
                    @certificateDocumentFid
                </a>&nbsp;
            </span>
        }
    </div>
}

@foreach (var playdevice in playground.playdevices)
{
    <div style="margin: 2em;padding: 1em;border: 1px solid grey">
        <h3>@playdevice.properties.type.description</h3>
        @if (playdevice.properties.cannotBeChecked)
        {
            <div style="margin: 0.5em;padding: 0.5em;background-color: rgb(225, 208, 247)"><b>inaktiv</b></div>
        }
        else if (playdevice.properties.notToBeChecked)
        {
            <div style="margin: 0.5em;padding: 0.5em;background-color: rgb(238, 213, 144)"><b>inaktiv</b></div>
        }

        <div>
            <img title="Foto des Spielger&auml;ts"
                style="display: block;width: 50%;margin-left: auto;margin-right: auto;margin-top: 0.5em;"
                src="Playdevice/@playdevice.properties.fid/Picture?t=@(imageCacheBuster.TryGetValue(playdevice.properties.fid, out var val) ? val : "")">
            @if (!playdevice.properties.notToBeChecked)
            {
                <div>
                    <span style="font-size: 50%;margin-left:1em;">Foto ersetzen...</span>
                    <InputFile OnChange="e => UploadImage(playdevice.properties.fid, e)" accept="image/png"
                        style="padding: 1em;" />
                </div>
            }
        </div>
        <p><b>Norm (Jahrgang)</b>: @playdevice.properties.type.standard</p>
        <p><b>Lieferant</b>: @playdevice.properties.supplier</p>
        <p><b>Erstellungsjahr</b>: @playdevice.properties.constructionDate.ToString("dd.MM.yyyy")</p>
        <div style="margin: 2em;">
            <p>
                <form-field style="width: 15em;">
                    <label>Empfohlenes Sanierungsjahr</label><br>
                    <input @bind="playdevice.properties.recommendedYearOfRenovation"
                        min="@DateTime.Now.Year" max="9999" type="number"
                        @onblur="@(() => CheckYear(playdevice))"                        
                        placeholder="Empfohlenes Sanierungsjahr...">
                </form-field>
            </p>
            <form>
                <form-field appearance="fill">
                    <label>Sanierungsart</label><br>
                    <select @bind="playdevice.properties.renovationType" required>
                        <option value="0"></option>
                        <option value="1">Totalsanierung</option>
                        <option value="2">Teilsanierung</option>
                    </select>
                </form-field>
            </form>
            <p>
                <form-field style="width: 20em;">
                    <label>Kommentar zum empf. Sanierungsjahr</label><br>
                    <textarea matInput maxlength="255" @bind="playdevice.properties.commentRecommendedYearOfRenovation"
                        placeholder="Kommentar zum empf. Sanierungsjahr..." style="width: 100%;" />
                </form-field>
            </p>
                <p style="margin: 2em;">
        <input type="checkbox" @bind="playdevice.properties.cannotBeChecked" />
        <label>Nicht prüfbar</label><br>
    </p>
    @if (playdevice.properties.cannotBeChecked)
    {
        <div>
            <form-field style="width: 100%;">
                <label>Begründung, weshalb das Gerät nicht prüfbar ist</label><br><br>
                <textarea matInput maxlength="255" @bind="playdevice.properties.cannotBeCheckedReason"
                    placeholder="Begründung, weshalb das Gerät nicht prüfbar ist..." style="width: 100%;" required />
            </form-field>
        </div>
        <div *ngIf="playdevice.properties.cannotBeChecked && !playdevice.properties.cannotBeCheckedReason"
            style="padding: 1em;border: 2px solid;color: rgb(156, 2, 2);background-color: rgb(255, 223, 226);">
            Die Angabe einer Begründung ist obligatorisch, um den Bericht senden zu können.
        </div>
    }
        </div>
        <div>
            <button class="btn btn-primary" @onclick="() => UpdateRenovation(playdevice)"
                disabled="@((playdevice.properties.recommendedYearOfRenovation != null
                                && playdevice.properties.recommendedYearOfRenovation < DateTime.Today.Year)
                                || (playdevice.properties.recommendedYearOfRenovation != null
                                && playdevice.properties.recommendedYearOfRenovation >= DateTime.Today.Year
                                && playdevice.properties.renovationType == 0) ||
                                (playdevice.properties.cannotBeChecked && 
                                string.IsNullOrWhiteSpace(playdevice.properties.cannotBeCheckedReason)))"
                style="margin: 2em;">
                Speichern
            </button>
            <NavLink href="@($"/inspectionprotocol/{playdevice.properties.fid}")">
                Inspektionsprotokolle</NavLink>
        </div>
    </div>
}

@code {
    private IEnumerable<Playground> playgrounds = new Playground[0];
    private Playground playground = new Playground();
    private Dictionary<int, string> imageCacheBuster = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        playgrounds = PlaygroundService.GetOnlyNames("Keine Inspektion", user);
    }

    private async Task OnPlaygroundChanged()
    {
        if (playground.name != "")
        {
            playground = PlaygroundService
            .GetByName(playground.name, "Keine Inspektion", true);
        }
        else
        {
            playground = new Playground();
        }
    }

    private void CheckYear(PlaydeviceFeature playdevice)
    {
        if (playdevice.properties.recommendedYearOfRenovation.HasValue &&
            playdevice.properties.recommendedYearOfRenovation.Value < DateTime.Today.Year)
                playdevice.properties.renovationType = 0;
    }

    private async Task UploadImage(int playdeviceFid, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream(50 * 1024 * 1024); // 50MB max picture size
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            string base64String = Convert.ToBase64String(ms.ToArray());
            base64String = ImageHelper.DownsizeImage(base64String, 1200, 800);

            await PlaygroundService.PutPlaydevicePictureAsync(playdeviceFid, base64String, false);

            // Cache-Buster aktualisieren
            imageCacheBuster[playdeviceFid] = DateTime.UtcNow.Ticks.ToString();
            StateHasChanged(); // Bild neu rendern
        }
    }

    private async Task UpdateRenovation(PlaydeviceFeature playdevice)
    {
        PlaydeviceFeatureDAO playdeviceFeatureDAO = new PlaydeviceFeatureDAO();
        playdeviceFeatureDAO.Update(playdevice, false);
    }

}
