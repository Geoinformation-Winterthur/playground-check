@inject SnackbarService SnackbarService

<div class="snackbar @SnackbarCssClass">@_message</div>

@code {
    private string _message = string.Empty;
    private string SnackbarCssClass = string.Empty;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        SnackbarService.Register(Show);
    }

    private void Show(string message, int durationMs)
    {
        _ = ShowInternalAsync(message, durationMs);
    }

    private async Task ShowInternalAsync(string message, int durationMs)
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        _message = message;
        SnackbarCssClass = "show";
        StateHasChanged();

        try
        {
            await Task.Delay(durationMs, _cts.Token);
        }
        catch (TaskCanceledException) { return; }

        SnackbarCssClass = string.Empty;
        StateHasChanged();
    }
}
