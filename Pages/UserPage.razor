@page "/user/{email}"
@using playground_check.Model
@using playground_check.Service
@inject NavigationManager NavigationManager
@inject SnackbarService SnackbarService
@inject IUserService UserService
@inject NavigationManager Nav
@attribute [Authorize(Roles = "administrator")]

<h1>Benutzerdaten @if (!string.IsNullOrWhiteSpace(user?.firstName)) {
    <span style="font-weight: normal;">/
        @user.firstName</span>
        }
</h1>

@if (!string.IsNullOrWhiteSpace(user?.errorMessage))
{
    <div style="padding: 1em;border-color: brown;border: 1px solid;background-color: rgb(247, 192, 192);">
        @user.errorMessage
    </div>
}

<EditForm Model="@user" OnValidSubmit="UpdateUser">
    <div>
        <div>
            <h3>Persönliche Daten</h3>
            <div style="width: 80%; margin-right: 1em;">
                <InputText @bind-Value="user.lastName" class="form-control" placeholder="Nachname" />
                <br />
                <InputText @bind-Value="user.firstName" class="form-control" placeholder="Vorname" />
                <br />
                <input value="@user.mailAddress" class="form-control" placeholder="E-Mail-Adresse" disabled />
                <br />
                <label for="role">Rolle</label><br>
                <InputSelect @bind-Value="user.role" id="role" class="form-select">
                    <option value="administrator">Administrator</option>
                    <option value="inspector">Kontrolleur</option>
                </InputSelect>
                <br />
                <InputCheckbox @bind-Value="user.active" />
                <label>Aktiv</label><br>
            </div>
        </div>

        <div style="margin-top: 2em;margin-bottom: 2em;">
            <button class="btn btn-primary" type="submit">ÄNDERUNGEN SPEICHERN</button>
        </div>

        <div class="user-card">
            <h3>Sicherheit / Passphrase</h3>
            <div style="background-color: rgb(255, 246, 246);padding: 1em;">
                <InputText @bind-Value="user.passPhrase" class="form-control" placeholder="Passphrase"
                    type="password" />
                <br />
                @if (!string.IsNullOrWhiteSpace(user.mailAddress))
                {
                    <button class="btn btn-secondary" type="button" @onclick="ChangePassphrase"
                        style="margin:1em;">PASSPHRASE ÄNDERN</button>
                    <button class="btn btn-secondary" type="button" @onclick="DeleteUser" style="margin:1em;">BENUTZER
                        LÖSCHEN</button>
                }
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public string email { get; set; }
    private User user = new();
    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(email))
            user = UserService.GetUser(email);
    }

    private async Task UpdateUser()
    {
        UserService.UpdateUser(user, false);
    }

    private async Task OnActiveChanged(ChangeEventArgs e)
    {
        user.active = (bool)e.Value;
        await UpdateUser();
    }

    private async Task OnUserRoleChange(ChangeEventArgs e)
    {
        user.role = e.Value?.ToString();
        await UpdateUser();
    }

    private async Task ChangePassphrase()
    {
        UserService.UpdateUser(user, true);
    }

    private async Task DeleteUser()
    {
        UserService.DeleteUser(email);
        Nav.NavigateTo("/useradmin");
    }
}
