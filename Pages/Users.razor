@page "/useradmin"
@using playground_check.Model
@using playground_check.Service
@inject IUserService UserService
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "administrator")]

<!--
 Author: Edgar Butwilowski
 Copyright (c) Fachstelle Geoinformation Winterthur. All rights reserved.
-->

<div style="margin: 2em;">
    <h1>Benutzeradministration</h1>
    <p>Hier k&ouml;nnen Sie Benutzer dieses Systems freischalten, deaktivieren oder bearbeiten.</p>

    <EditForm Model="this">
        <InputCheckbox @bind-Value="showInactiveUsers" @onchange="UpdateUsersList" />
        <label style="margin: 0.5em;">Inaktive Benutzer einblenden</label><br><br />

        @if (showInactiveUsers)
        {
            <InputCheckbox @bind-Value="onlyShowNewUsers" @onchange="UpdateUsersList" />
            <label style="margin: 0.5em;">Nur neue Benutzer anzeigen</label><br>
        }
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(responseMessage))
    {
        <p style="color: red;">@responseMessage</p>
    }

    <table class="table table-striped" style="width: 100%;">
        <thead>
            <tr>
                <th></th>
                <th>Vorname</th>
                <th>Nachname</th>
                <th>E-Mail-Adresse</th>
                <th>Rolle</th>
                <th>Aktiv</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in filteredUsers)
            {
                <tr>
                    <td>
                        <a class="btn btn-sm btn-primary" title="Benutzer bearbeiten" href="@($"/user/{user.mailAddress}")">
                            Bearbeiten
                        </a>
                    </td>
                    <td>@user.firstName</td>
                    <td>@user.lastName</td>
                    <td>@user.mailAddress</td>
                    <td>
                        @(user.role == "inspector" ? "Kontrolleur" : user.role == "administrator" ? "Administrator" : user.role)
                    </td>
                    <td>
                        <input type="checkbox" checked="@user.active" disabled />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private bool showInactiveUsers = false;
    private bool onlyShowNewUsers = false;
    private string responseMessage = string.Empty;
    private User[] users = [];

    private IEnumerable<User> filteredUsers => users
        .Where(u => showInactiveUsers || u.active)
        .Where(u => !onlyShowNewUsers || u.role == null);

    protected override async Task OnInitializedAsync()
    {
        await UpdateUsersList();
    }

    private async Task UpdateUsersList()
    {
        try
        {
            string? email = null;
            users = UserService.GetUsers(email);
            responseMessage = string.Empty;
        }
        catch (Exception ex)
        {
            responseMessage = "Fehler beim Laden der Benutzerdaten: " + ex.Message;
        }
    }
}